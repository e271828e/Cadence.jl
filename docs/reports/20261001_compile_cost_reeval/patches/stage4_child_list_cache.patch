 """
 const WALK_FACES = ScopedValue{Union{Nothing,IdDict{Any,Tuple{Vector{String},Vector{String}}}}}(nothing)
 
+# The running walk's child lists, by instance: endpoint resolution asks for an
+# assembly's children once per endpoint, and a list is a function of the value.
+const WALK_KIDS = ScopedValue{Union{Nothing,IdDict{Any,Vector{Pair{String,Any}}}}}(nothing)
+function _walked_children(base::String, @nospecialize(assembly))
+    memo = WALK_KIDS[]
+    memo === nothing && return children(base, assembly)
+    get!(() -> children(base, assembly), memo, assembly)
+end
