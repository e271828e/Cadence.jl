+function PhaseBody(@nospecialize(interior::Tuple))
+    walk = @opaque(Tuple{} -> Nothing, () -> (_walkchunks(interior); _kept(interior)))
+    # A closure calling a captured closure allocates, so the index arity walks
+    # the chunks itself; it compiles only the calls, the chunks being compiled.
+    PhaseBody(interior, interior, walk,
