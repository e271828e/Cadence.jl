+# --- one opaque closure per entry ---------------------------------------------
+# An entry and the buffers it runs over are closed into an opaque closure, so a
+# walk is a loop over a vector whose type carries nothing of the model. The
+# closure's body compiles once per entry *type*: a second instance of a known
+# type reuses it, and the executor's type no longer depends on the topology.
+#
+# Opaque closures run in the world they were created in: a method redefined
+# after compilation reaches a simulation only when it is built again.
+
+using Base.Experimental: @opaque
+
+const Thunk = Core.OpaqueClosure{Tuple{},Nothing}
+
+# Boxed on purpose: the vector's eltype is abstract, so each element is a heap
+# object `_invoke` hands over as is. A concretely typed `Vector{Thunk}` stores
+# the closures inline, and on Julia 1.13 every call of an inline closure goes
+# through a `specptr` adapter that boxes it again, 48 bytes per call.
+const AnyThunk = Core.OpaqueClosure{Tuple{}}
+const Thunks = Vector{AnyThunk}
+
+# The closure's own entry point, `jl_fptr_args` with no arguments: the
+# allocation-free call of a boxed closure, without dynamic dispatch.
+@inline _invoke(f) =
+    (ccall((f::Thunk).invoke, Any, (Any, Ptr{Any}, UInt32), f, C_NULL, 0); nothing)
+
+_entry_thunk(entry, store, xbuf, ẋbuf) =
+    @opaque Tuple{} -> Nothing () -> (run_entry!(entry, store, xbuf, ẋbuf); nothing)
+
